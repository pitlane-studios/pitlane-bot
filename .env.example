# Copy to .env and fill in. Never commit .env.

# Developer Portal › Bot › Reset Token. Secret: never log, paste or commit it.
DISCORD_TOKEN=

# Developer Portal › General Information › Application ID (public).
DISCORD_CLIENT_ID=

# SQLite file holding sanctions and panel message ids (docs/spec/stack.md › Data).
DATABASE_PATH=./data/pitlane-bot.sqlite

# Versioned config file for this guild: config/production.json or config/development.json.
CONFIG_PATH=./config/development.json
